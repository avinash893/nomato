{
  "name": "realtime",
  "version": "1.0.0",
  "description": "Nomato Realtime Socket.IO Service",
  "main": "dist/index.js",
  "type": "commonjs",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "concurrently \"tsc --watch\" \"node --watch dist/index.js\""
